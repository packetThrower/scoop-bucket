{
    "version": "0.9.5-beta.6",
    "description": "Cross-platform serial terminal for network devices (pre-release channel)",
    "homepage": "https://github.com/packetThrower/Baudrun",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/packetThrower/Baudrun/releases/download/v0.9.5-beta.6/Baudrun_0.9.5-beta.6_x64-setup.exe",
            "hash": "ac47d23efa264d3abaf550912e00d600845b551ce7676602a7a01afefe906c29"
        },
        "arm64": {
            "url": "https://github.com/packetThrower/Baudrun/releases/download/v0.9.5-beta.6/Baudrun_0.9.5-beta.6_arm64-setup.exe",
            "hash": "fcdffe06fb73d27e3d20b5e53a0c32f1dbebbad2c3736dbeb02155f8ef781d8d"
        }
    },
    "installer": {
        "script": [
            "Start-Process -Wait -FilePath \"$dir\\$fname\" -ArgumentList @('/S', \"/D=$dir\")",
            "Remove-Item \"$dir\\$fname\" -Force"
        ]
    },
    "uninstaller": {
        "script": "if (Test-Path \"$dir\\uninstall.exe\") { Start-Process -Wait -FilePath \"$dir\\uninstall.exe\" -ArgumentList '/S' }"
    },
    "bin": [
        [
            "Baudrun.exe",
            "baudrun-alpha"
        ]
    ],
    "shortcuts": [
        [
            "Baudrun.exe",
            "Baudrun Alpha"
        ]
    ],
    "checkver": {
        "url": "https://github.com/packetThrower/Baudrun/releases.atom",
        "regex": "v(\\d+\\.\\d+\\.\\d+-[\\w.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/packetThrower/Baudrun/releases/download/v$version/Baudrun_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/packetThrower/Baudrun/releases/download/v$version/Baudrun_$version_arm64-setup.exe"
            }
        }
    },
    "notes": [
        "Baudrun Alpha is a pre-release. Installs alongside the stable",
        "`baudrun` manifest if you have it; CLI shim is exposed as",
        "`baudrun-alpha` and the Start menu shortcut is `Baudrun Alpha`.",
        "",
        "USB-serial adapter compatibility matrix:",
        "https://github.com/packetThrower/Baudrun/blob/main/docs/ADAPTERS.md"
    ]
}

{
    "version": "0.8.1",
    "description": "Cross-platform CLI/GUI flash programmer for the CH341A USB SPI/I²C interface",
    "homepage": "https://github.com/packetThrower/etch341",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/packetThrower/etch341/releases/download/v0.8.1/etch341-0.8.1-amd64-windows-setup.exe",
            "hash": "293a48df39ea2de7df0b5629cfd5460824046df56020b79071a0c2c195855329"
        },
        "arm64": {
            "url": "https://github.com/packetThrower/etch341/releases/download/v0.8.1/etch341-0.8.1-arm64-windows-setup.exe",
            "hash": "fa983f706e11d9f76f12bf248150d245d1786b2237634856c8235de02c3a7830"
        }
    },
    "installer": {
        "script": [
            "Start-Process -Wait -FilePath \"$dir\\$fname\" -ArgumentList @('/S', \"/D=$dir\")",
            "Remove-Item \"$dir\\$fname\" -Force"
        ]
    },
    "uninstaller": {
        "script": "if (Test-Path \"$dir\\uninstall.exe\") { Start-Process -Wait -FilePath \"$dir\\uninstall.exe\" -ArgumentList '/S' }"
    },
    "bin": "etch341.exe",
    "shortcuts": [
        [
            "etch341.exe",
            "etch341"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/packetThrower/etch341/releases/download/v$version/etch341-$version-amd64-windows-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/packetThrower/etch341/releases/download/v$version/etch341-$version-arm64-windows-setup.exe"
            }
        }
    },
    "notes": [
        "Windows needs a one-time WinUSB driver bind for the CH341A device.",
        "Run Zadig (https://zadig.akeo.ie/), pick 'CH341A USB' from the device",
        "list, choose 'WinUSB', and click Replace Driver. Without this step",
        "etch341 detect / read / write report 'DeviceNotFound'."
    ]
}

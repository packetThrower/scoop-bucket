{
    "version": "0.10.0-beta.2",
    "description": "Local-first daily-journal and outliner note app (pre-release channel)",
    "homepage": "https://github.com/packetThrower/zorite",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/packetThrower/zorite/releases/download/v0.10.0-beta.2/zorite_0.10.0-beta.2_x64-setup.exe",
            "hash": "ca65704aacbd7e34269258c28db35cae8c44392f2bc6dae64e5af4c3992143b2"
        },
        "arm64": {
            "url": "https://github.com/packetThrower/zorite/releases/download/v0.10.0-beta.2/zorite_0.10.0-beta.2_arm64-setup.exe",
            "hash": "a069fe9fe06d538aab6207c905c273e310b5b48e5469bb712525c10d260c80e8"
        }
    },
    "installer": {
        "script": [
            "Start-Process -Wait -FilePath \"$dir\\$fname\" -ArgumentList @('/S', \"/D=$dir\")",
            "Remove-Item \"$dir\\$fname\" -Force"
        ]
    },
    "uninstaller": {
        "script": "if (Test-Path \"$dir\\uninstall.exe\") { Start-Process -Wait -FilePath \"$dir\\uninstall.exe\" -ArgumentList '/S' }"
    },
    "bin": [
        [
            "Zorite.exe",
            "zorite-alpha"
        ]
    ],
    "shortcuts": [
        [
            "Zorite.exe",
            "Zorite Alpha"
        ]
    ],
    "checkver": {
        "url": "https://github.com/packetThrower/zorite/releases.atom",
        "regex": "v(\\d+\\.\\d+\\.\\d+-[\\w.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/packetThrower/zorite/releases/download/v$version/zorite_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/packetThrower/zorite/releases/download/v$version/zorite_$version_arm64-setup.exe"
            }
        }
    },
    "notes": [
        "Zorite Alpha is the pre-release channel. Installs alongside the stable",
        "`zorite` manifest; its shim is exposed as `zorite-alpha` and the Start",
        "menu shortcut is `Zorite Alpha`. Currently parked on v0.1.0 until the",
        "next pre-release ships."
    ]
}

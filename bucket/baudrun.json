{
    "version": "0.9.5",
    "description": "Cross-platform serial terminal for network devices",
    "homepage": "https://github.com/packetThrower/Baudrun",
    "license": "GPL-3.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/packetThrower/Baudrun/releases/download/v0.9.5/Baudrun_0.9.5_x64-setup.exe",
            "hash": "e4a8c764475f0dfdf8fe4aef9d61f77919d05b23591600d1aabaedb617b43347"
        },
        "arm64": {
            "url": "https://github.com/packetThrower/Baudrun/releases/download/v0.9.5/Baudrun_0.9.5_arm64-setup.exe",
            "hash": "4e70a0d50503ea6fa7cdde953918b8903ac0adfa081288a1437851d6760eb48e"
        }
    },
    "installer": {
        "script": [
            "Start-Process -Wait -FilePath \"$dir\\$fname\" -ArgumentList @('/S', \"/D=$dir\")",
            "Remove-Item \"$dir\\$fname\" -Force"
        ]
    },
    "uninstaller": {
        "script": "if (Test-Path \"$dir\\uninstall.exe\") { Start-Process -Wait -FilePath \"$dir\\uninstall.exe\" -ArgumentList '/S' }"
    },
    "bin": "Baudrun.exe",
    "shortcuts": [
        [
            "Baudrun.exe",
            "Baudrun"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/packetThrower/Baudrun/releases/download/v$version/Baudrun_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/packetThrower/Baudrun/releases/download/v$version/Baudrun_$version_arm64-setup.exe"
            }
        }
    },
    "notes": [
        "USB-serial adapter compatibility varies by chipset; some need a",
        "vendor driver while others work via Baudrun's bundled libusb",
        "backend. See the support matrix at",
        "https://github.com/packetThrower/Baudrun/blob/main/docs/ADAPTERS.md"
    ]
}

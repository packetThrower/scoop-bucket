{
    "version": "4.0.0-alpha.8",
    "description": "Network switch port discovery via CDP / LLDP / MNDP (pre-release channel)",
    "homepage": "https://github.com/packetThrower/PortFinder",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/packetThrower/PortFinder/releases/download/v4.0.0-alpha.8/PortFinder_4.0.0-alpha.8_x64-setup.exe",
            "hash": "f7036bd0f2de63f8fcdefa2309e9279fcc1ab5e161cdbd7601217a0d5091d382"
        },
        "arm64": {
            "url": "https://github.com/packetThrower/PortFinder/releases/download/v4.0.0-alpha.8/PortFinder_4.0.0-alpha.8_arm64-setup.exe",
            "hash": "b24380365cc794e73a5f41bc20fb248072d445197cfb57f38e2299c46cde0765"
        }
    },
    "installer": {
        "script": [
            "Start-Process -Wait -FilePath \"$dir\\$fname\" -ArgumentList @('/S', \"/D=$dir\")",
            "Remove-Item \"$dir\\$fname\" -Force"
        ]
    },
    "uninstaller": {
        "script": "if (Test-Path \"$dir\\uninstall.exe\") { Start-Process -Wait -FilePath \"$dir\\uninstall.exe\" -ArgumentList '/S' }"
    },
    "bin": [
        [
            "PortFinder.exe",
            "portfinder-alpha"
        ]
    ],
    "shortcuts": [
        [
            "PortFinder.exe",
            "PortFinder Alpha"
        ]
    ],
    "checkver": {
        "url": "https://github.com/packetThrower/PortFinder/releases.atom",
        "regex": "v(\\d+\\.\\d+\\.\\d+-[\\w.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/packetThrower/PortFinder/releases/download/v$version/PortFinder_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/packetThrower/PortFinder/releases/download/v$version/PortFinder_$version_arm64-setup.exe"
            }
        }
    },
    "notes": [
        "PortFinder Alpha is a pre-release. Installs alongside the stable",
        "`portfinder` manifest if you have it; CLI is exposed as",
        "`portfinder-alpha` and the Start menu shortcut is",
        "`PortFinder Alpha`.",
        "",
        "Packet capture on Windows still requires Npcap. Get it from",
        "https://npcap.com/#download and tick",
        "'Allow non-administrators to capture' during install."
    ]
}

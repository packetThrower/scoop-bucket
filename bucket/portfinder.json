{
    "version": "4.1.0",
    "description": "Network switch port discovery via CDP / LLDP / MNDP",
    "homepage": "https://github.com/packetThrower/PortFinder",
    "license": "GPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/packetThrower/PortFinder/releases/download/v4.1.0/PortFinder_4.1.0_x64-setup.exe",
            "hash": "56b36dfceb81a0219cd355472a02a5f514149393e8e7d9b8cf985924c06ccfaa"
        },
        "arm64": {
            "url": "https://github.com/packetThrower/PortFinder/releases/download/v4.1.0/PortFinder_4.1.0_arm64-setup.exe",
            "hash": "7db2d08eddb4322c2373c6af609dc314d63a0c9aebf60f5b70e2a3c0b08b1166"
        }
    },
    "installer": {
        "script": [
            "Start-Process -Wait -FilePath \"$dir\\$fname\" -ArgumentList @('/S', \"/D=$dir\")",
            "Remove-Item \"$dir\\$fname\" -Force"
        ]
    },
    "uninstaller": {
        "script": "if (Test-Path \"$dir\\uninstall.exe\") { Start-Process -Wait -FilePath \"$dir\\uninstall.exe\" -ArgumentList '/S' }"
    },
    "bin": [
        [
            "portfinder-cli.exe",
            "portfinder"
        ]
    ],
    "shortcuts": [
        [
            "PortFinder.exe",
            "PortFinder"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/packetThrower/PortFinder/releases/download/v$version/PortFinder_$version_x64-setup.exe"
            },
            "arm64": {
                "url": "https://github.com/packetThrower/PortFinder/releases/download/v$version/PortFinder_$version_arm64-setup.exe"
            }
        }
    },
    "notes": [
        "Packet capture on Windows requires Npcap.",
        "Get it from https://npcap.com/#download and tick",
        "'Allow non-administrators to capture' during install."
    ]
}
